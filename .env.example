# Copy this file as your base for environment-specific config, then fill in
# your real values. It is NOT committed with values — keep this template a
# placeholder only.
#
#   cp .env.example .env.development   # local dev
#   cp .env.example .env.production    # production deploy
#
# .env.development and .env.production are gitignored (see .gitignore).

# Shopify app credentials (https://partners.shopify.com)
# Required — app fails to boot without these when running the Rails server.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL of your app; must be reachable by Shopify webhooks and the Fygaro
# Hook URL (e.g. https://yourapp.example.com or a tunnel URL).
HOST=

# Only required for private-store installs
# SHOPIFY_APP_PRIVATE_SHOP=

# Billing test charges
# SHOPIFY_TEST_CHARGES=

# ---- Fygaro (upstream hosted payment gateway) ----
# API key used as the JWT `kid` and as the Fygaro-Key-ID on incoming hooks.
FYGARO_API_KEY=
# API secret used to sign the payment JWT (HMAC-SHA256) and verify hooks.
FYGARO_API_SECRET=
# Shareable Fygaro Link URL that hosts the hosted checkout, e.g.
# https://www.fygaro.com/en/pb/<link-uuid>/
FYGARO_PAYMENT_LINK_URL=
# Webhook verification secret, set equal to FYGARO_API_SECRET. Fygaro signs
# hooks with the API secret.
FYGARO_WEBHOOK_SECRET=
# Offline fallback FX rate (IDR per 1 USD) used only when the ECB rate cache is
# unavailable. Fygaro does not support IDR, so checkout amounts are converted.
FYGARO_IDR_TO_USD_RATE=16000
