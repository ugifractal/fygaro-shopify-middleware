<div class="mx-auto max-w-3xl">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-xl font-semibold text-gray-900">Webhook Settings</h1>
    <%= button_to "Recreate webhooks",
          recreate_webhooks_path,
          method: :post,
          class: "rounded bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700" %>
  </div>

  <p class="mt-1 text-sm text-gray-500">Manage the webhooks registered on your Shopify store.</p>

  <div class="mt-6 rounded border border-gray-200 bg-white">
    <% if @webhooks.empty? %>
      <p class="px-4 py-6 text-sm text-gray-500">No webhooks</p>
    <% else %>
      <ul class="divide-y divide-gray-200">
        <% @webhooks.each do |webhook| %>
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <span class="font-mono text-sm text-gray-900"><%= webhook["topic"] %></span>
            <span class="truncate text-sm text-gray-500"><%= webhook.dig("endpoint", "callbackUrl") || "—" %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="mt-8">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Storefront Access Token</h2>
        <p class="mt-1 text-sm text-gray-500">
          Used to quote cart costs and shipping for the custom checkout.
          <%= current_shop.storefront_access_token.present? ? "Configured." : "Not yet created." %>
        </p>
      </div>
      <%= button_to "Create or rotate token",
            rotate_storefront_token_path,
            method: :post,
            class: "rounded border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
    </div>

    <form action="<%= store_storefront_token_path %>" method="post" class="mt-4 flex items-end gap-3 rounded border border-gray-200 bg-white p-4">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <div class="flex-1">
        <label for="storefront_access_token" class="block text-sm font-medium text-gray-700">
          Paste a Storefront API access token (used when Shopify blocks automated creation)
        </label>
        <input
          type="text"
          name="storefront_access_token"
          id="storefront_access_token"
          value="<%= current_shop.storefront_access_token %>"
          autocomplete="off"
          spellcheck="false"
          placeholder="shpat_…"
          class="mt-1 w-full rounded border border-gray-300 px-3 py-2 font-mono text-sm text-gray-900"
        >
      </div>
      <button type="submit" class="rounded border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">
        Save token
      </button>
    </form>
  </div>
</div>